config {
  type: "table",
  database: dataform.projectConfig.vars.bronze_project,
  schema: dataform.projectConfig.vars.bronze_dataset,
  name: "bronze_austin_311",
  tags: ["bronze"],
  description: "Raw ingestion of Austin 311 service requests"
}

SELECT
  *
FROM ${ref("311_service_requests")}
WHERE created_date >= TIMESTAMP("2026-01-01")
