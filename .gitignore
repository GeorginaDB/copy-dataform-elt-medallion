# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Terraform init
.terraform.lock.hcl
.terraform.modules.tf

# Ignore the import script
terraform_import.sh

# Ignore keys
keys/*
!.gitkeep
